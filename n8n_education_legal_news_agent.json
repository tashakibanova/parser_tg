        980,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = getWorkflowStaticData('global');\nif (!data.seen) data.seen = {};\n\nconst keywords = [\n  'приказ', 'закон', 'федеральный', 'методичес', 'аккредитац',\n  'лиценз', 'санпин', 'фгос', 'аттестаци', 'учебн', 'образован'\n];\n\nconst maxAgeHours = 72;\nconst now = Date.now();\n\nconst out = [];\nfor (const item of items) {\n  const title = (item.json.title || '').toString();\n  const link = (item.json.link || item.json.guid || '').toString();\n  const content = (item.json.contentSnippet || item.json.content || item.json.description || '').toString();\n  const pubDate = item.json.isoDate || item.json.pubDate || item.json.published || null;\n\n  if (!link || !title) continue;\n\n  const haystack = `${title} ${content}`.toLowerCase();\n  const matched = keywords.some(k => haystack.includes(k));\n  if (!matched) continue;\n\n  if (pubDate) {\n    const ageMs = now - new Date(pubDate).getTime();\n    if (!Number.isNaN(ageMs) && ageMs > maxAgeHours * 60 * 60 * 1000) continue;\n  }\n\n  if (data.seen[link]) continue;\n  data.seen[link] = now;\n\n  out.push({\n    json: {\n      title,\n      link,\n      source: item.json.creator || item.json['dc:creator'] || item.json.feedUrl || 'Источник',\n      publishedAt: pubDate,\n      rawText: content.replace(/<[^>]*>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 5000)\n    }\n  });\n}\n\nconst ttl = 14 * 24 * 60 * 60 * 1000;\nfor (const [url, ts] of Object.entries(data.seen)) {\n  if (now - ts > ttl) delete data.seen[url];\n}\n\nreturn out;"
      },
