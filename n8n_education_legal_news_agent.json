    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.3,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты редактор телеграм-канала для руководителей школ и вузов. Переписывай новости в точный, нейтральный и полезный формат.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Сделай короткий пост (до 900 символов) по шаблону: 1) Что произошло. 2) Кого касается. 3) Что делать образовательной организации. 4) Ссылка на источник.\\n\\nЗаголовок: {{$json.title}}\\nИсточник: {{$json.source}}\\nДата: {{$json.publishedAt}}\\nТекст: {{$json.rawText}}\\nСсылка: {{$json.link}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "10",
      "name": "Rewrite with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1880,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiText = $json.choices?.[0]?.message?.content || 'Не удалось подготовить текст.';\nconst sourceLink = $('Split In Batches').item.json.link;\nconst title = $('Split In Batches').item.json.title;\n\nreturn [{\n  json: {\n    message: `📚 ${title}\\n\\n${aiText}\\n\\n🔗 ${sourceLink}`\n  }\n}];"
      },
